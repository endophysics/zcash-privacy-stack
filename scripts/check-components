#!/usr/bin/env python3

from pathlib import Path
import sys


sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from scripts.component_status import inspect_lock_file, render_status
from scripts.component_lock import ComponentLockError


def main() -> int:
    try:
        report = inspect_lock_file(Path.cwd() / "components.lock.toml")
    except ComponentLockError as error:
        print(error, file=sys.stderr)
        return 1
    print(render_status(report))
    return report.exit_code


raise SystemExit(main())
