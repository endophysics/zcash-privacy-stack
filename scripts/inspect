#!/usr/bin/env python3

from pathlib import Path
import sys


sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from scripts.component_lock import ComponentLockError
from scripts.component_status import inspect_lock_file, render_status


def main() -> int:
    try:
        report = inspect_lock_file(Path.cwd() / "components.lock.toml")
    except ComponentLockError as error:
        print(error, file=sys.stderr)
        return 1
    print(render_status(report))
    print("inspection_boundary=zakura_checkout_status")
    print("end_to_end_service=absent")
    print("wp00_limit=no_end_to_end_service")
    return report.exit_code


raise SystemExit(main())
