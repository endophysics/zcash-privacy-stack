{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zcash:privacy-stack:privacy-policy:1",
  "title": "Zcash Privacy Service Policy",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "policy_version",
    "service_id",
    "network",
    "valid_from",
    "valid_until",
    "node",
    "private_write",
    "read_privacy"
  ],
  "properties": {
    "policy_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "network": {
      "type": "string",
      "enum": ["mainnet", "testnet", "regtest"]
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "node": {
      "type": "object",
      "additionalProperties": true,
      "required": ["implementation", "revision", "fixed_logical_egress"],
      "properties": {
        "implementation": {
          "type": "string",
          "enum": ["zakura", "zebra", "development"]
        },
        "revision": {
          "type": "string",
          "minLength": 7
        },
        "upstream_base": {
          "type": "string"
        },
        "fixed_logical_egress": {
          "type": "boolean"
        }
      }
    },
    "private_write": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "submission_protocol",
        "padding_bytes",
        "minimum_delay_ms",
        "maximum_delay_ms",
        "release_mode",
        "relay_set_id",
        "gateway_key_id",
        "attestation_required",
        "direct_fallback_allowed"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "submission_protocol": {
          "type": "string",
          "enum": ["ohttp-zcash-tx-v1", "development-direct-v1"]
        },
        "padding_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "minimum_delay_ms": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_delay_ms": {
          "type": "integer",
          "minimum": 0
        },
        "epoch_ms": {
          "type": "integer",
          "minimum": 1
        },
        "release_mode": {
          "type": "string",
          "enum": ["immediate", "fixed_epoch", "rolling_pool"]
        },
        "relay_set_id": {
          "type": "string",
          "minLength": 1
        },
        "gateway_key_id": {
          "type": "string",
          "minLength": 1
        },
        "attestation_required": {
          "type": "boolean"
        },
        "direct_fallback_allowed": {
          "const": false
        }
      }
    },
    "read_privacy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "range_bucket_size",
        "lookback_blocks",
        "poll_interval_ms",
        "mempool_epoch_ms",
        "separate_write_session",
        "canonical_objects",
        "transaction_specific_queries_allowed",
        "transparent_local_scan"
      ],
      "properties": {
        "range_bucket_size": {
          "type": "integer",
          "minimum": 1
        },
        "lookback_blocks": {
          "type": "integer",
          "minimum": 0
        },
        "poll_interval_ms": {
          "type": "integer",
          "minimum": 1
        },
        "mempool_epoch_ms": {
          "type": "integer",
          "minimum": 1
        },
        "separate_write_session": {
          "const": true
        },
        "canonical_objects": {
          "type": "boolean"
        },
        "transaction_specific_queries_allowed": {
          "const": false
        },
        "transparent_local_scan": {
          "type": "boolean"
        }
      }
    },
    "attestation_bundle_url": {
      "type": "string",
      "format": "uri"
    },
    "canonical_manifest_url": {
      "type": "string",
      "format": "uri"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "private_write": {
            "type": "object",
            "additionalProperties": true,
            "required": ["release_mode"],
            "properties": {
              "release_mode": {
                "const": "fixed_epoch"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "private_write": {
            "type": "object",
            "additionalProperties": true,
            "required": ["epoch_ms"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "private_write": {
            "type": "object",
            "additionalProperties": true,
            "required": ["attestation_required"],
            "properties": {
              "attestation_required": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": ["attestation_bundle_url"]
      }
    },
    {
      "if": {
        "properties": {
          "read_privacy": {
            "type": "object",
            "required": ["canonical_objects"],
            "properties": {
              "canonical_objects": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": ["canonical_manifest_url"]
      }
    }
  ]
}
